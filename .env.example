# Telegram API credentials (get from https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017

# Bot owner user IDs (comma-separated)
OWNERS=123456789,987654321

# Optional: Monitored channels (comma-separated)
MONITORED_CHANNELS=

# Logging configuration
MAX_LOG_AGE_HOURS=24
MAX_LOG_SIZE_BYTES=2097152

# Optional: External OCR service URL (e.g., http://100.118.146.248:8181/api/ocr or http://localhost:8181/api/ocr)
# Leave empty to use Tesseract or Google Drive API
EXTERNAL_OCR_SERVICE_URL=

# Optional: Port for the simple OCR service (default: 8181)
PORT=

# Default OCR method to attempt first (remaining methods are tried as fallbacks in order).
# Options: external | google_drive | tesseract
# Default: external
DEFAULT_OCR_METHOD=tesseract

# Whether to enable Tesseract as a local OCR option.
# Requires pytesseract and the system package tesseract-ocr to be installed.
# Set to false on low-resource or restricted machines to skip Tesseract entirely.
# Default: true
INSTALL_TESSERACT=true

